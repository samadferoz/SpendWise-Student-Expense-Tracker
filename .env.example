# ==============================================================================
# SpendWise — Student Expense Tracker Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# IBM Cloudant NoSQL Database Configuration (External Hosted)
# 1. Log in to https://cloud.ibm.com/
# 2. Open your IBM Cloudant Service instance
# 3. Navigate to "Service credentials" tab -> Click "New credential"
# 4. Copy "url" and "apikey" below:
CLOUDANT_URL=https://your-instance-id-bluemix.cloudantnosqldb.appdomain.cloud
CLOUDANT_APIKEY=your_ibm_cloudant_iam_apikey_here
CLOUDANT_DB_NAME=spendwise_db

# Optional legacy CouchDB credentials (if not using IAM API key):
# CLOUDANT_USERNAME=your_username
# CLOUDANT_PASSWORD=your_password

# Frontend Dev Proxy Target (for local non-Docker development)
VITE_BACKEND_URL=http://localhost:5000
